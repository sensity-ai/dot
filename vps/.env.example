# LemonSqueezy API configuration
# Sign up at https://lemonsqueezy.com (works in Australia)

LEMON_SQUEEZY_API_KEY=your_api_key_here
LEMON_SQUEEZY_STORE_ID=your_store_id
LEMON_SQUEEZY_PRODUCT_ID=your_product_id

# VPS Model Server
VPS_MODELS_DIR=/var/www/models
VPS_PORTAL_DIR=/var/www/portal

# API Key settings
KEY_EXPIRY_DAYS=365
KEY_LENGTH=32
