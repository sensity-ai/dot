# Copy to .env and set your values (optional).
# .env is gitignored; do not commit secrets.

# HuggingFace token: higher rate limits and faster downloads from HF Hub.
# Create at https://huggingface.co/settings/tokens
# HF_TOKEN=your_token_here

# Optional: custom cache directory for downloaded models (default: ~/.cache/dot/diffusion)
# DOT_CACHE_DIR=/path/to/cache
